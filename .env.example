# for Docker only: copy to .env and edit, docker compose reads it automatically
# without Docker, use server/.env.example instead

# port to open the site on, e.g. http://<server-ip>:8080
PORT=8080

# folder on the host that contains one sub-folder per manga
MANGA_DIR=/mnt/manga

# comma separated folder names inside MANGA_DIR to hide
# (names that themselves contain a comma can't be listed here)
IGNORE_LIST=kenja no mago,mangadownloader

# look up covers and details (sends your manga folder names to the metadata source, which is
# AniList unless you pick another on the settings page)
FETCH_METADATA=false

# folder on the host your extensions are in, see docs/extensions.md
EXTENSIONS_DIR=./extensions

# comma separated extensions to run from EXTENSIONS_DIR; they get full access to the container,
# so only use ones you trust
ENABLED_EXTENSIONS=

# comma separated domain names you open the site on, e.g. manga.example.com; ip addresses, names
# without a dot and .local names always work
ALLOWED_HOSTS=
