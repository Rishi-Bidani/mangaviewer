# for running without Docker: copy to .env next to this file and edit, then restart the server
# (with Docker, use the .env.example in the repository root instead)
# anything set in the actual environment wins over this file
#
# values don't need quotes, even with spaces or backslashes; only put one in 'single quotes' if it
# contains a #, which otherwise starts a comment. Avoid "double quotes" around windows paths, they
# turn \n into a line break

# port to open the site on, e.g. http://<server-ip>:8080
PORT=8080

# folder that contains one sub-folder per manga
BASE_MANGA_FOLDER=D:\manga

# comma separated folder names to hide (names that themselves contain a comma can't be listed)
IGNORE_LIST=kenja no mago,mangadownloader

# look up covers and details (sends your manga folder names to the metadata source, which is
# AniList unless you pick another on the settings page)
FETCH_METADATA=false

# where the database and downloaded covers are kept, by default server/data/metadata
# METADATA_FOLDER=

# where your extensions are kept, by default server/data/extensions, see docs/extensions.md
# EXTENSIONS_FOLDER=

# comma separated extensions to run from EXTENSIONS_FOLDER; they get full access to your computer,
# so only use ones you trust
ENABLED_EXTENSIONS=

# comma separated domain names you open the site on, e.g. manga.example.com; ip addresses, names
# without a dot and .local names always work
ALLOWED_HOSTS=
