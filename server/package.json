{
    "name": "@mangaviewer/server",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "main": "dist/main.js",
    "files": [
        "dist",
        "data"
    ],
    "author": "Rishi",
    "license": "MIT",
    "scripts": {
        "dev": "node --watch ./src/main.ts",
        "build": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
        "start": "node ./dist/main.js",
        "bundle": "tsdown",
        "lint": "biome lint",
        "format": "biome format --write",
        "check": "biome check --write"
    },
    "dependencies": {
        "cors": "^2.8.5",
        "express": "^5.1.0",
        "natural-orderby": "^3.0.1"
    },
    "devDependencies": {
        "@biomejs/biome": "2.5.15",
        "@tsdown/exe": "0.23.1",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.0",
        "@types/node": "^24.19.2",
        "tsdown": "^0.23.1",
        "typescript": "^7.0.2"
    }
}
