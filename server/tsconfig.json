{
    "compilerOptions": {
        "target": "ES2023",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "types": ["node"],
        "rootDir": ".",
        "outDir": "../dist/server",

        /* node runs the .ts files directly in dev (type stripping), so only
           erasable syntax is allowed and imports use .ts extensions; tsc
           rewrites those to .js in the build output */
        "erasableSyntaxOnly": true,
        "verbatimModuleSyntax": true,
        "allowImportingTsExtensions": true,
        "rewriteRelativeImportExtensions": true,

        "strict": true,
        "forceConsistentCasingInFileNames": true,
        "skipLibCheck": true
    },
    "include": ["**/*.ts"]
}
